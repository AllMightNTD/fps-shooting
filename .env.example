# Sample configuration placeholders (NEVER put real secrets here)

# Backend server port (Render injects PORT automatically)
PORT=8090

# Comma-separated allowed WebSocket Origins on Render (leave empty for local/LAN open mode)
ALLOWED_ORIGIN=https://your-fps-game.pages.dev

# Build-time WebSocket endpoint injected into dist-static/index.html for Cloudflare Pages
FPS_WS_URL=wss://your-fps-server.onrender.com/ws

